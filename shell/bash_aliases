alias ls='ls -Glah --color=auto'
alias watch='watch ' # trailing space is deliberate, it lets bash expand aliases inside the watched command
alias rsync='rsync --progress'

# awk body must stay single-quoted: in double quotes the shell ate $1 and fed whole lines to branch -d.
alias git-clean-branches='git branch -vv | grep origin | grep gone | awk '"'"'{print $1}'"'"' | xargs -r -L 1 git branch -d'
